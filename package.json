{
  "name": "shop-teacher",
  "version": "1.1.0",
  "description": "Teach apps to read shop prices, and optionally product sizes, with Gemini-written recipes, with one Gemini API key shared by every app on the machine.",
  "author": "zgyorkei",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zgyorkei/shop-teacher.git"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./gemini": {
      "import": { "types": "./dist/gemini/index.d.ts", "default": "./dist/gemini/index.js" },
      "require": { "types": "./dist/gemini/index.d.cts", "default": "./dist/gemini/index.cjs" }
    },
    "./browser": {
      "import": { "types": "./dist/browser/index.d.ts", "default": "./dist/browser/index.js" },
      "require": { "types": "./dist/browser/index.d.cts", "default": "./dist/browser/index.cjs" }
    },
    "./measure": {
      "import": { "types": "./dist/measure/index.d.ts", "default": "./dist/measure/index.js" },
      "require": { "types": "./dist/measure/index.d.cts", "default": "./dist/measure/index.cjs" }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "shop-teacher": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "^2.1.2"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "tsup": "^9.0.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
